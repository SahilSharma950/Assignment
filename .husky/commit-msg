#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "📝 Validating commit message format..."

commit_regex='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}$'
commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qP "$commit_regex"; then
  echo ""
  echo "❌ Invalid commit message format!"
  echo ""
  echo "   Expected: <type>(<scope>): <description>"
  echo "   Example:  feat(auth): add JWT refresh token rotation"
  echo ""
  echo "   Allowed types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert"
  echo ""
  exit 1
fi

echo "✅ Commit message is valid!"
